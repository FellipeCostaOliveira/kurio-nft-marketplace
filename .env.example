# Ativa a camada MSW (REST + Socket.IO simulados). Obrigatório no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST feitas pelo Axios (interceptadas pelo MSW).
VITE_API_URL=/api
# Endpoint Socket.IO (interceptado pelo MSW via @mswjs/socket.io-binding).
VITE_SOCKET_URL=wss://realtime.kurio.test
# Cenário inicial dos mocks (ver README > Cenários). Pode ser trocado em runtime.
VITE_MOCK_SCENARIO=default
