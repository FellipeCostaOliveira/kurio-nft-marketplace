  "scripts": {
    "dev": "vite",
    "dev:mocks": "cross-env VITE_ENABLE_MOCKS=true vite",
    "build": "tsc -b && vite build",
    "build:demo": "cross-env VITE_ENABLE_MOCKS=true npm run build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "msw:init": "msw init public --save",
